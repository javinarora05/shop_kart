# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/shopkart
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopkart?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shopkart

# JWT Secret Key for Signing Authentication Tokens
JWT_SECRET=shopkart_super_secret_jwt_key_2026_secure

# Environment Mode (development | production)
NODE_ENV=development

# Allowed Frontend URL for CORS & Cookie Exchange
FRONTEND_URL=http://localhost:5173


RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret